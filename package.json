{
  "name": "dsh-project-orchestrator",
  "version": "1.5.6",
  "description": "Local-first AI project orchestration workbench and CLI plugin for DeepSeek Harness: approval-gated planning, Git worktrees, task execution, Issues, and auditable evidence.",
  "license": "MIT",
  "author": "zhangz-2018",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "bin": {
    "dsh-project-orchestrator": "lib/cli.js",
    "project-orchestrator": "lib/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/client.js",
    "lib/client.js.map",
    "lib/cli.js",
    "lib/pdf.worker.mjs",
    "lib/types",
    "README.md",
    "README.zh-CN.md",
    "docs",
    "CONTRIBUTING.md",
    "CONTRIBUTING.zh-CN.md",
    "SECURITY.md",
    "SECURITY.zh-CN.md",
    "SUPPORT.md",
    "SUPPORT.zh-CN.md",
    "GOVERNANCE.md",
    "GOVERNANCE.zh-CN.md",
    "CODE_OF_CONDUCT.md",
    "CODE_OF_CONDUCT.zh-CN.md",
    "CHANGELOG.md",
    "CHANGELOG.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "docs:check": "node scripts/docs-smoke.mjs",
    "smoke:package": "node scripts/package-smoke.mjs",
    "verify": "pnpm run typecheck && pnpm run docs:check && pnpm run test && pnpm run smoke:package",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run verify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangz-2018/dsh-project-orchestrator.git"
  },
  "homepage": "https://github.com/zhangz-2018/dsh-project-orchestrator#readme",
  "bugs": {
    "url": "https://github.com/zhangz-2018/dsh-project-orchestrator/issues"
  },
  "keywords": [
    "deepseek",
